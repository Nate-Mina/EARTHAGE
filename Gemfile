source "https://rubygems.org"

# Minimal, stable build. The site is a single self-contained page (index.html,
# layout: none) with its own dark-mode CSS, so it does not need the full
# `github-pages` monolith or a Jekyll theme gem.
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
end
