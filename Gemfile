source "https://rubygems.org"

# GitHub Pages toolchain (pinned to a safe version range).
# `github-pages` pulls in the Jekyll version GitHub Pages uses in production.
gem "github-pages", group: :jekyll_plugins

# The Cayman theme is bundled with github-pages; no extra gem needed.
# If you switch _config.yml's `theme:` to a non-bundled theme, add its gem here.

group :jekyll_plugins do
  gem "jekyll-feed"
end
